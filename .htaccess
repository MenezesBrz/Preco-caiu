# ============================================================
# O PREÇO CAIU - WEB SERVER FIREWALL & SECURITY RULES (.htaccess)
# Protection against SQL Injection, XSS, JS Injection, and Web Attacks
# Compatible with Apache, LiteSpeed, and cPanel environments
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. ENFORCE HTTPS (SSL Encrypted Traffic)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. ACTIVE SQL INJECTION FILTER
  # Blocks query strings containing SQL command keywords, delimiters, and functions
  RewriteCond %{QUERY_STRING} [^a-zA-Z0-9_](union|select|insert|update|delete|drop|table|concat|benchmark|sleep)[^a-zA-Z0-9_] [NC,OR]
  RewriteCond %{QUERY_STRING} (\%27)|(\')|(\-\-)|(\%23)|(#) [NC,OR]
  RewriteCond %{QUERY_STRING} (information_schema|schema\(|user\() [NC]
  RewriteRule ^(.*)$ - [F,L]

  # 3. ACTIVE CROSS-SITE SCRIPTING (XSS & JS INJECTION) FILTER
  # Blocks query strings attempting to inject scripts, tags, or DOM event handlers
  RewriteCond %{QUERY_STRING} (<|%3C)([^s]*s)+cript.*(>|%3E) [NC,OR]
  RewriteCond %{QUERY_STRING} (javascript:|vbscript:|data:text/html) [NC,OR]
  RewriteCond %{QUERY_STRING} (onload|onerror|onclick|onmouseover|eval\(|document\.cookie) [NC]
  RewriteRule ^(.*)$ - [F,L]

  # 4. PATH TRAVERSAL & SENSITIVE FILE ACCESS FILTER
  RewriteCond %{QUERY_STRING} (\.\./|\.\.\\|%2e%2e) [NC]
  RewriteRule ^(.*)$ - [F,L]
</IfModule>

# 5. DISABLE DIRECTORY BROWSING
# Prevents unauthorized file indexing and directory reconnaissance
Options -Indexes

# 6. BLOCK ACCESS TO HIDDEN AND CONFIGURATION FILES (.git, .env, .htaccess)
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# 7. HTTP SECURITY HEADERS (HARDENED PROFILE)
<IfModule mod_headers.c>
  # Anti-Clickjacking & UI Redressing Defense
  Header always set X-Frame-Options "DENY"

  # Anti-MIME Sniffing Defense
  Header always set X-Content-Type-Options "nosniff"

  # Referrer Privacy Enforcement
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict Access to Sensitive Hardware Device Features
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # HTTP Strict Transport Security (HSTS - 1 Year with SubDomains and Preload)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Strict Content Security Policy (CSP)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; object-src 'none'; base-uri 'self'; form-action 'self';"
</IfModule>
