# ============================================================
# O PREÇO CAIU - REGRAS DE CIBERSEGURANÇA (.htaccess)
# Proteção contra SQL Injection, XSS, JS Injection e Ataques Web
# Compatível com Apache, LiteSpeed e cPanel
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. FORÇAR HTTPS (Tráfego Criptografado com SSL)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. BLOQUEIO ATIVO DE INJEÇÃO SQL (SQL INJECTION FILTER)
  # Bloqueia qualquer URL contendo UNION, SELECT, INSERT, DROP, etc.
  RewriteCond %{QUERY_STRING} [^a-zA-Z0-9_](union|select|insert|update|delete|drop|table|concat|benchmark|sleep)[^a-zA-Z0-9_] [NC,OR]
  RewriteCond %{QUERY_STRING} (\%27)|(\')|(\-\-)|(\%23)|(#) [NC,OR]
  RewriteCond %{QUERY_STRING} (information_schema|schema\(|user\() [NC]
  RewriteRule ^(.*)$ - [F,L]

  # 3. BLOQUEIO ATIVO DE CROSS-SITE SCRIPTING (XSS & JS INJECTION)
  # Bloqueia qualquer URL tentando injetar scripts, tags ou manipuladores de evento
  RewriteCond %{QUERY_STRING} (<|%3C)([^s]*s)+cript.*(>|%3E) [NC,OR]
  RewriteCond %{QUERY_STRING} (javascript:|vbscript:|data:text/html) [NC,OR]
  RewriteCond %{QUERY_STRING} (onload|onerror|onclick|onmouseover|eval\(|document\.cookie) [NC]
  RewriteRule ^(.*)$ - [F,L]

  # 4. BLOQUEIO DE PATH TRAVERSAL E ARQUIVOS SENSÍVEIS
  RewriteCond %{QUERY_STRING} (\.\./|\.\.\\|%2e%2e) [NC]
  RewriteRule ^(.*)$ - [F,L]
</IfModule>

# 5. DESATIVAR LISTAGEM DE DIRETÓRIOS (DIRECTORY BROWSING)
# Impede que invasores vejam a lista de arquivos das pastas
Options -Indexes

# 6. BLOQUEAR ARQUIVOS OCULTOS OU DE CONFIGURAÇÃO (.git, .env, .htaccess)
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# 7. CABEÇALHOS HTTP DE SEGURANÇA (SECURITY HEADERS)
<IfModule mod_headers.c>
  # Prevenção de Clickjacking (Iframe)
  Header always set X-Frame-Options "DENY"

  # Prevenção de MIME Sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Proteção contra vazamento de referenciador
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Desativa recursos invasivos de hardware do navegador
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Força HTTPS permanente no navegador (HSTS - 1 ano)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Content Security Policy (CSP Estrito)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; object-src 'none'; base-uri 'self'; form-action 'self';"
</IfModule>
